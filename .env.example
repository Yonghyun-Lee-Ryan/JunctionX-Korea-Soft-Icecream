# 이 파일은 참고용입니다. 서버가 실제로 읽는 파일은 backend/.env 하나입니다.
#
#   cp backend/.env.example backend/.env
#
# 변수 이름과 기본값은 backend/.env.example 에 정리해 두었습니다.
# Studio 에이전트 ID 는 이미 채워져 있고, 직접 넣어야 하는 키는 아래 셋뿐입니다.

# 팀 공용 Upstage 키. 회사 서류 업로드(POST /api/docs/upload)에 씁니다.
UPSTAGE_API_KEY=

# 에이전트를 만든 개인 Studio 계정 키. 공고 해부와 회사 카드, Solar 판정에 씁니다.
UPSTAGE_AGENT_API_KEY=

# 공공데이터포털 나라장터 서비스키. 공고 목록 조회에 씁니다.
DATA_GO_KR_SERVICE_KEY=
