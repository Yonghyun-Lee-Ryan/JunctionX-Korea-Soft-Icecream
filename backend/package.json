{
  "name": "junctionx-korea-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable JunctionX Korea hackathon REST API backend harness",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node scripts/clean-build.mjs",
    "check:conflicts": "node scripts/check-conflict-files.mjs",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run db:test:prepare && vitest run",
    "test:watch": "node scripts/prepare-test-database.mjs && vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run db:test:prepare && vitest run tests/integration",
    "test:coverage": "npm run db:test:prepare && vitest run --coverage",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:prepare": "node scripts/prepare-test-database.mjs",
    "secret:generate": "node scripts/generate-secret.mjs",
    "generate:module": "node scripts/generate-module.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run check:conflicts && npm run db:validate && npm run db:generate && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api db"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.9.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
