{
  "name": "solar-for-bid-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Solar for Bid — 나라장터 공고를 제안 착수 패키지로 바꾸는 파이프라인의 백엔드",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/reset.js",
    "test": "node --test tests/*.test.js",
    "test:agents:live": "node scripts/run-workflow-agents-live-smoke.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "unpdf": "^1.8.1"
  }
}
