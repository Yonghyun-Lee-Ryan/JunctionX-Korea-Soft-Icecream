G2B_LIST_MAX_ROWS=300

# ── 데모 ───────────────────────────────────────────────
LIVE_FALLBACK_MS=20000
DEMO_CASE_ID=R25BK00645031-000

# ── Studio 에이전트 6종 (정운 계정) ─────
# 🔴 2026-08-23 공고 해부 5종을 다시 임포트했다(v2 · SERVICE_OPERATION_RFP 갈래) — 새 Agent 라 ID 가 바뀌었고 무료 실행 10회가 새로 시작한다.
#    옛 ID(01 agt_2z8o… · 02 agt_YkBx… · 03 agt_Vk8s… · 04 agt_n7LX… · 05 agt_BL4w…)는 갈래가 둘뿐이라 용역 RFP 를 못 읽는다.
# 설정 원본 agent/*.json · 사용법 agent/README.md · 인수서 backend/HANDOFF-solar-judgment.md
# 🔴 이 6종은 정운 Studio 계정에 있다 — 위의 UPSTAGE_API_KEY(팀 계정)로는 못 부른다.
#    정운 계정 console 키를 여기에. 공고 해부·회사 카드·Solar 판정 층이 이 키를 쓴다. 비우면 fixtures/studio 로 폴백.
UPSTAGE_AGENT_API_KEY=
# 🔴 서류별 STUDIO_AGENT_BIZ_REG 등 8개는 COMPANY_CARD 하나로 대체된다 (갈래 9+1)
STUDIO_AGENT_ANNOUNCEMENT_OVERVIEW_ID=agt_m3jgg8xxo36eUZ7Y3VtzbK
STUDIO_AGENT_ANNOUNCEMENT_SCOPE_CONTEXT_ID=agt_kkLc9mQwFWf72MH2iPsjJi
STUDIO_AGENT_ANNOUNCEMENT_REQUIREMENTS_ID=agt_eHjFLqtaGBzAaCF8A7Yzgf
STUDIO_AGENT_ANNOUNCEMENT_ELIGIBILITY_SUBMISSION_ID=agt_7Cg3HLb2pggLdpQTUz8doa
STUDIO_AGENT_ANNOUNCEMENT_ELIGIBILITY_SUBMISSION_CONFIG=1
STUDIO_AGENT_ANNOUNCEMENT_CONDITIONS_EVALUATION_ID=agt_KfxL8VwSpdoo6foGwLtYii
STUDIO_AGENT_COMPANY_CARD_ID=agt_iixJqRpLkzbUxUsB4kudho
STUDIO_AGENT_COMPANY_CARD_CONFIG=1

# ── Solar 판정 층 (백엔드가 Chat API 직접 호출 · 키는 UPSTAGE_AGENT_API_KEY) ──
SOLAR_CHAT_URL=https://api.upstage.ai/v1/chat/completions
SOLAR_MODEL=solar-pro3
SOLAR_REASONING_EFFORT=medium
# 판정 한 번의 상한(ms). 큰 공고는 2분을 넘긴다 — 기본 300000
SOLAR_TIMEOUT_MS=300000
