{
  "_주의": "🔴 04:00 동결 대상. 프론트·백엔드의 유일한 접점이다. 필드 이름이 아니라 '봉투'를 얼린다 — Extract가 무엇을 뱉든 화면 코드가 안 바뀐다.",
  "_왜_봉투인가": "프리플라이트(08:00)가 동결(04:00) 뒤에 있다. 200쪽 HWP에서 Extract가 실제로 무엇을 뱉는지 아무도 본 적이 없고, 장문 F1이 41.3/63.2라 값이 안 나오는 필드가 반드시 생긴다. 필드 이름으로 계약하면 그때마다 계약이 깨지고 화면③ 탭4와 xlsx 빌더가 동시에 재작업된다.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["caseId", "status", "verdict", "tabs", "downloads"],
  "properties": {
    "caseId": { "type": "string", "description": "공고번호-차수 (예: 'R25BK00645031-000')" },
    "status": { "type": "string", "enum": ["collecting", "parsing", "judging", "done", "failed"] },
    "progress": {
      "type": "array", "description": "화면②의 단계 표시. 순서대로",
      "items": { "type": "object", "required": ["step", "state"], "properties": {
        "step":  { "type": "string", "description": "예: '첨부 5건 수집'" },
        "state": { "type": "string", "enum": ["pending", "running", "done", "failed"] },
        "detail":{ "type": "string" } } }
    },
    "verdict": {
      "type": "object", "description": "화면③ 상단 배지. 이게 헤드라인이다",
      "required": ["badge"],
      "properties": {
        "badge":   { "type": "string", "enum": ["go", "no-go", "conditional", "unknown"] },
        "headline":{ "type": "string", "description": "한 문장 이유" },
        "reasons": { "type": "array", "items": { "type": "object", "properties": {
          "text":       { "type": "string" },
          "page":       { "type": "integer", "description": "근거 쪽. 모르면 0" },
          "docId":      { "type": "string", "description": "어느 첨부에서 나왔나 (fileSeq)" },
          "confidence": { "type": "string", "enum": ["high", "low", "unknown"] } } } }
      }
    },
    "tabs": {
      "type": "array",
      "description": "🔴 화면③ 탭. 프론트는 columns/rows를 범용 표로 렌더한다 — 탭이 늘거나 열이 바뀌어도 화면 코드가 안 바뀐다",
      "items": { "type": "object", "required": ["id", "title", "columns", "rows"], "properties": {
        "id":      { "type": "string", "description": "compliance | wbs | criticalpath | cost | risk | checklist | questions | coverage" },
        "title":   { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows":    { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "warnings":{ "type": "array", "items": { "type": "string" }, "description": "검산 실패·불일치. 표 위에 붉게 뜬다" },
        "summary": { "type": "string", "description": "예: '전체 151건 중 미대응 0건'" } } }
    },
    "downloads": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "label", "url"], "properties": {
        "id":    { "type": "string" },
        "label": { "type": "string", "description": "예: '요구사항조견표.xlsx'" },
        "url":   { "type": "string" },
        "bytes": { "type": "integer" } } }
    },
    "meta": {
      "type": "object", "properties": {
        "cached":       { "type": "boolean", "description": "🔴 사전 실행 결과면 true. 화면 구석에 표시한다 — 들키는 것보다 먼저 말하는 쪽이 싸다" },
        "agentId":      { "type": "string" },
        "configVersion":{ "type": "string" },
        "elapsedMs":    { "type": "integer" },
        "attachments":  { "type": "array", "items": { "type": "object", "properties": {
          "fileSeq":  { "type": "integer" },
          "filename": { "type": "string" },
          "docClass": { "type": "string" },
          "bytes":    { "type": "integer" } } } }
      }
    },
    "error": { "type": "object", "properties": {
      "code":    { "type": "string" },
      "message": { "type": "string", "description": "사람이 읽는 문장. 무엇이 잘못됐고 어떻게 고치나" } } }
  }
}
